# Copy to .env and fill in. Never commit .env.
# All variables use the KT_ prefix and are loaded by kronostrading.config.settings.Secrets.

# Path to the YAML config (relative to the repo root or absolute)
KT_CONFIG_PATH=config/default.yaml

# Telegram alerts (phase 3)
KT_TELEGRAM_BOT_TOKEN=
KT_TELEGRAM_CHAT_ID=

# Slack alerts (optional, phase 3)
KT_SLACK_WEBHOOK_URL=

# Macro data from FRED (free key: https://fred.stlouisfed.org/docs/api/api_key.html)
KT_FRED_API_KEY=

# Paid market/fundamental data (optional fallback if Yahoo blocks the server IP)
KT_EODHD_API_KEY=

# Hugging Face token (not required for the public Kronos models)
KT_HF_TOKEN=
